# 이 파일을 복사해서 .env 로 이름을 바꾸고 값을 채우세요.

# 서버 포트
PORT=8080

# 로컬 MySQL 접속 정보
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=여기에_MySQL_비밀번호
DB_NAME=mibs_form

# 클라우드 MySQL 처럼 SSL 이 필요하면 true
DB_SSL=false
# SSL 인증서 검증 오류가 나면 false 로
# DB_SSL_REJECT_UNAUTHORIZED=false

# 프론트 주소 (CORS 허용)
CLIENT_ORIGIN=http://localhost:5173

# 관리자 페이지(/admin) 비밀번호
ADMIN_PASSWORD=여기에_관리자_비밀번호
